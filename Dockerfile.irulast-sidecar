FROM golang:1.27.3-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9 AS build
ENV GOMAXPROCS=2 GOFLAGS="-mod=readonly -p=2" CGO_ENABLED=0
WORKDIR /src
COPY . .
ARG SOURCE_REVISION
RUN test -n "$SOURCE_REVISION" && cd ./sidecar && go build -trimpath -ldflags "-s -w -X github.com/minio/operator/sidecar/pkg.Version=6.0.4-irulast.1 -X github.com/minio/operator/sidecar/pkg.ReleaseTag=v6.0.4-irulast.1 -X github.com/minio/operator/sidecar/pkg.CommitID=$SOURCE_REVISION -X github.com/minio/operator/sidecar/pkg.ShortCommitID=$SOURCE_REVISION" -o /out/minio-operator-sidecar ./cmd/sidecar

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates && addgroup -g 1000 minio && adduser -D -u 1000 -G minio minio
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/irulast/minio-operator" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.vendor="irulast"
COPY --from=build /out/minio-operator-sidecar /minio-operator-sidecar
COPY LICENSE CREDITS /licenses/
USER 1000:1000
ENTRYPOINT ["/minio-operator-sidecar"]
